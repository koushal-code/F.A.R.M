rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Farmer Profile Validator
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'preferredLanguage', 'locationName', 'createdAt']) &&
        data.id == userId &&
        data.id is string && isValidId(data.id) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage in ['en', 'hi', 'te', 'kn', 'ta'])) &&
        (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 200));
    }

    // Crop Diagnostic Scan Validator
    function isValidCropScan(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'cropName', 'diagnosisName', 'severityLevel', 'healthScore']) &&
        data.keys().hasOnly(['id', 'userId', 'cropName', 'diagnosisName', 'severityLevel', 'healthScore', 'confidenceScore', 'imageUrl', 'locationName', 'notes', 'diagnosisData', 'createdAt']) &&
        data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.cropName is string && data.cropName.size() > 0 && data.cropName.size() <= 100 &&
        data.diagnosisName is string && data.diagnosisName.size() > 0 && data.diagnosisName.size() <= 150 &&
        data.severityLevel is string && data.severityLevel.size() > 0 && data.severityLevel.size() <= 50 &&
        data.healthScore is number && data.healthScore >= 0 && data.healthScore <= 100 &&
        (!('confidenceScore' in data) || (data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 10000)) &&
        (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 200)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('diagnosisData' in data) || (data.diagnosisData is string && data.diagnosisData.size() <= 50000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /scans/{scanId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(scanId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(scanId) &&
          incoming().id == scanId &&
          isValidCropScan(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(scanId) &&
          isValidCropScan(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(scanId);
      }
    }
  }
}
